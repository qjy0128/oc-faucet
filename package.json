{
  "name": "oc-faucet",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "OC Faucet — 把 OpenCode 免费模型接入十种 AI 编程工具：模型体检、协议翻译、信封约束、一键接入，内嵌与伪装双上游",
  "author": "qjy0128",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/main.js",
    "web": "node src/main.js --web",
    "stop": "node scripts/service.mjs stop",
    "restart": "node scripts/service.mjs restart",
    "test": "node --test test/*.test.js",
    "desktop": "node scripts/desktop.mjs",
    "verify": "node scripts/verify.mjs",
    "dist": "electron-builder --mac --win",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "keywords": [
    "opencode",
    "zcode",
    "faucet",
    "anthropic",
    "openai-compatible",
    "electron",
    "llm"
  ],
  "main": "desktop/main.cjs",
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.qjy0128.oc-faucet",
    "productName": "OC Faucet",
    "directories": {
      "output": "release",
      "buildResources": "desktop/build"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "web/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "desktop/build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "desktop/build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
